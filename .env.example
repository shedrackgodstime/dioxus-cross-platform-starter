# Server-side Paystack secret key. Never place this in a client build.
PAYSTACK_SECRET_KEY=
# Set to "simulation" only for local development without Paystack credentials.
# PAYSTACK_MODE=simulation

# Optional backend URL baked into native client builds.
STARTER_SERVER_URL=
# Comma-separated browser origins allowed to call the API.
# Leave empty for same-origin-only deployments. Never use '*' with credentials.
CORS_ALLOWED_ORIGINS=

# Optional Paystack integration user-agent label.
PAYSTACK_USER_AGENT=CrossPlatformStarter/0.1
